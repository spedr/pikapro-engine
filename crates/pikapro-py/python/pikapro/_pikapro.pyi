@final
class Battle:
    """One battle, created from a format id, two teams (Showdown export or
    packed text) and a seed (an int for the fast RNG, four 16-bit ints for
    Showdown's Gen 5 PRNG, or 32 bytes for its default sodium PRNG)."""

    def __init__(
        self,
        format: str,
        teams: Sequence[TeamText],
        seed: Optional[Seed] = None,
        *,
        log: bool = True,
        players: Optional[Sequence[str]] = None,
    ) -> None: ...
    format: str
    players: list[str]
    space: ActionSpace
    seed: Seed
    turn: int
    over: bool
    winner: Optional[int]
    result: Optional[Record]
    event_count: int
    def request_kind(self, side: Side) -> Literal["wait", "team_preview", "move", "force_switch"]: ...
    def request(self, side: Side) -> Record: ...
    def request_json(self, side: Side) -> str: ...
    def legal_actions(self, side: Side) -> list[int]: ...
    def legal_choices(self, side: Side) -> list[Choice]: ...
    def slot_actions(self, side: Side) -> list[list[int]]: ...
    def action_mask(self, side: Side) -> npt.NDArray[np.bool_]: ...
    def slot_mask(self, side: Side) -> npt.NDArray[np.bool_]: ...
    def submit(self, side: Side, choice: ChoiceLike) -> bool: ...
    def parse_choice(self, side: Side, choice: str) -> Choice: ...
    def choice_index(self, side: Side, choice: ChoiceLike) -> int: ...
    def forfeit(self, side: Side) -> None: ...
    def fork(self, seed: Optional[Seed] = None) -> Battle: ...
    def __copy__(self) -> Battle: ...
    def __deepcopy__(self, memo: Any, /) -> Battle: ...
    def events(self, start: int = 0) -> list[Any]: ...
    def log(self, perspective: Optional[Perspective] = None, start: int = 0) -> list[str]: ...
    def raw_log(self, start: int = 0) -> list[str]: ...
    def teams(self, packed: bool = False) -> list[str]: ...
    def header(self) -> list[str]: ...
    def state(self) -> Record: ...
    def arrays(self) -> tuple[npt.NDArray[np.int32], npt.NDArray[np.int32], npt.NDArray[np.int32]]: ...
    def open_team_sheets(self) -> list[str]: ...
    def view(self, side: Side) -> BattleView: ...
    def _view(self, side: Side) -> dict[str, Any]: ...

@final
class RandomPolicy:
    """Uniformly random legal choices (``pikapro play --seed S`` uses
    ``RandomPolicy(S ^ 0x5EED)``)."""

    def __init__(self, seed: int) -> None: ...
    def choose(self, battle: Battle, side: Side) -> Optional[Choice]: ...

@final
class RandomTeams:
    """Random teams from pikapro-teams, for one preset and mode; pass it as
    a BattlePool's ``teams`` for fresh teams every episode. Teams pass
    Showdown's validator except for ``mode="sets"`` in ``gen9randombattle``
    and ``gen9randomdoublesbattle``: that is Showdown's random-battle team
    generator, exactly (``team(seed)`` is Showdown's team for the seed
    ``gen5,<seed in 16 hex digits>``), and nothing validates its teams."""

    def __init__(
        self,
        format: str,
        mode: Literal["uniform", "sets"] = "uniform",
        *,
        level: Optional[int] = None,
        team_size: Optional[int] = None,
        spreads: Literal["competitive", "showdown"] = "competitive",
        species: Optional[Sequence[str]] = None,
        moves: Optional[Sequence[str]] = None,
        abilities: Optional[Sequence[str]] = None,
        items: Optional[Sequence[str]] = None,
    ) -> None: ...
    format: str
    mode: str
    def team(self, seed: int, packed: bool = False) -> str: ...
    def pair(self, seed: int, packed: bool = False) -> list[str]: ...

@final
class BattlePool:
    """``n`` battles stepped per call on Rust threads, GIL released."""

    def __init__(
        self,
        format: str,
        teams: Union[
            Literal["sets", "uniform", "random"], Sequence[TeamText], Sequence[Sequence[TeamText]], RandomTeams
        ],
        n: int,
        seed: int = 0,
        threads: Optional[int] = None,
        *,
        log: bool = False,
        autoreset: Optional[Literal["same_step", "next_step", "off"]] = "next_step",
        spin_us: int = 100,
    ) -> None: ...
    n: int
    threads: int
    autoreset: Optional[str]
    format: str
    space: ActionSpace
    def __len__(self) -> int: ...
    def step(
        self, actions: npt.ArrayLike
    ) -> tuple[npt.NDArray[np.int8], npt.NDArray[np.bool_], npt.NDArray[np.int8], npt.NDArray[np.uint8]]: ...
    def final_state(self) -> dict[str, npt.NDArray[Any]]: ...
    def masks(self, kind: Literal["choice", "slots", "preview"] = "choice") -> npt.NDArray[np.bool_]: ...
    def requests(self) -> npt.NDArray[np.int8]: ...
    def sample_random(self, mode: Literal["choice", "slots"] = "choice") -> npt.NDArray[np.int64]: ...
    def play_random(self, battles: int) -> dict[str, float]: ...
    def state(self) -> tuple[npt.NDArray[np.int32], npt.NDArray[np.int32], npt.NDArray[np.int32]]: ...
    def reset(self, indices: Optional[Sequence[int]] = None) -> None: ...
    def take_errors(self) -> list[tuple[int, int, str]]: ...
    def battle(self, i: int) -> Battle: ...
    def episodes(self) -> npt.NDArray[np.uint64]: ...
    def seeds(self) -> npt.NDArray[np.uint64]: ...
    def finished(self) -> dict[str, int]: ...

def formats() -> list[str]: ...
def sample_team(format: str) -> str: ...
def pack(team: str, format: str) -> str: ...
def export(team: str, format: str) -> str: ...
def validate(team: str, format: str) -> list[str]: ...
def names(table: Literal["species", "moves", "abilities", "items", "types"], format: str = "gen9vgc") -> list[str]: ...
def to_id(text: str) -> str: ...
def _wilson(wins: int, losses: int, ties: int, z: float = 1.96) -> tuple[float, float]: ...
def _panic(message: str) -> NoReturn: ...

