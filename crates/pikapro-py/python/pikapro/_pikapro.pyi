"""Type stubs for the `pikapro._pikapro` extension module (docs/python/api.md).

The extension's classes can't be subclassed (``@final``). Everything
public is re-exported by ``pikapro`` and ``pikapro.rl``: import it from there.
"""

from typing import Any, Literal, NoReturn, Optional, Sequence, Union, final

import numpy as np
import numpy.typing as npt

from .rl.view import BattleView

Side = Union[int, Literal["p1", "p2"]]
Perspective = Union[int, Literal["omniscient", "p1", "p2", "spectator"]]
Seed = Union[int, tuple[int, int, int, int], bytes]
TeamText = str
ChoiceLike = Union[int, Sequence[int], str, "Choice"]

#: The columns of the Pokémon rows of the raw state arrays
#: (:meth:`Battle.arrays`, :meth:`BattlePool.state`).
POKEMON_COLUMNS: list[str]
#: The columns of the side rows of the raw state arrays.
SIDE_COLUMNS: list[str]
#: The columns of the field row of the raw state arrays.
FIELD_COLUMNS: list[str]
#: The ``status`` column's codes, by value.
STATUS_CODES: list[str]
#: The ``weather`` column's codes, by value (-1: none).
WEATHER_CODES: list[str]
#: The ``terrain`` column's codes, by value (-1: none).
TERRAIN_CODES: list[str]
#: The codes of :meth:`BattlePool.requests`, by value.
REQUEST_CODES: list[str]
#: The name of each of the 128 volatile bits (``""`` for an unused one).
VOLATILE_NAMES: list[str]

@final
class Record:
    """A typed engine value: a struct or an enum variant with fields.

    Fields are attributes and items, and always win: the record's own
    members start with an underscore. ``_variant`` is the Rust type or
    variant name. IDs are names, unit variants are strings (an enum's own
    ``None`` variant is ``"None"``), ``Option`` is the value or ``None``; a
    variant with unnamed fields has ``value`` or ``values``.
    """

    _variant: str
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, name: str, /) -> Any: ...
    def __contains__(self, name: str, /) -> bool: ...
    def _keys(self) -> list[str]: ...
    def _to_dict(self) -> dict[str, Any]: ...

@final
class SlotAction:
    """One active slot's action: ``SlotAction("move", 0, target=1,
    gimmick="terastallize")``, ``SlotAction("switch", 2)``,
    ``SlotAction("pass")``. ``target``: Showdown's location (1, 2 foes;
    -1, -2 the user's side). ``index``: move slot or team position,
    0-based."""

    def __init__(
        self,
        kind: Literal["move", "switch", "pass"],
        index: Optional[int] = None,
        target: Optional[int] = None,
        gimmick: Optional[Literal["terastallize", "mega"]] = None,
    ) -> None: ...
    @property
    def kind(self) -> Literal["move", "switch", "pass"]: ...
    @property
    def index(self) -> Optional[int]: ...
    @property
    def target(self) -> Optional[int]: ...
    @property
    def gimmick(self) -> Optional[str]: ...

@final
class Choice:
    """A side's choice; ``str(choice)`` is the Showdown choice string."""

    @staticmethod
    def team(order: Sequence[int]) -> Choice: ...
    @staticmethod
    def from_actions(actions: Sequence[SlotAction]) -> Choice: ...
    @property
    def kind(self) -> Literal["actions", "team"]: ...
    @property
    def actions(self) -> list[SlotAction]: ...
    @property
    def order(self) -> list[int]: ...

